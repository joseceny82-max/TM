# ─── Datos / persistencia (NO versionar) ──────────────────────
*.json
*.json.bak.*
!package.json
!.github/**/*.json

# Permitir archivos de config TEMPLATE (sin credenciales)
!*.template.json

# ─── Logs ──────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ─── Backups y rescue ──────────────────────────────────────────
backups/
*.bak
*.bak.*
*.bak_*
*.rescue.*
*.rescue_*
*.bk

# ─── Secrets ───────────────────────────────────────────────────
secrets/
.env
.env.*
!.env.example
*.key
*.pem
session_key
.session_key

# ─── Datos de cuentas / compras ────────────────────────────────
datos/
staging_data/
plantilla_tm.csv
plantilla_tm.csv.*
cuentas_tarjetas.csv
*.csv.bak.*

# ─── Cache / artefactos navegador ──────────────────────────────
storage_states/
screenshots/
*.png
*.jpg
*.gif

# ─── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── IDE / editor ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Build / dist ──────────────────────────────────────────────
build/
dist/
*.egg-info/

# ─── SQLite (datos persistentes, NO versionar) ────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# ─── Lock / state files ────────────────────────────────────────
*.lock
*.pid
.locks/

# ─── Secrets de test con credenciales REALES (NO versionar) ───
_test_imap_madre.py

# ─── Diagnostics / runs (NO versionar — traces y logs del bot) ─
runs/
*.jsonl
*.backup_*
*.err
_bot_engine_slot_counter.txt
