# ═══════════════════════════════════════════════════════════
#  TM PERROS — variables de entorno
#  Copia a `.env` y rellena. NO commitees .env al repo.
# ═══════════════════════════════════════════════════════════

# ─── IDENTIDAD DEL HOST ───
# Identificador único de este bot/dashboard. Auto-generado si lo dejas vacío.
INSTANCE_ID=

# ─── REDIS (multi-host / distribuido) ───
# Si configuras REDIS_URL, el AcpAT pool, flow locks y heartbeats se
# comparten entre todos los hosts que apunten al mismo Redis.
# Sin Redis, funciona single-host con fallback local en memoria.
#
# Ejemplos:
#   REDIS_URL=redis://localhost:6379/0
#   REDIS_URL=redis://:mipassword@redis.mi-servidor.com:6379/0
#   REDIS_URL=rediss://default:xxx@eu1.upstash.io:6379   (Upstash TLS)
REDIS_URL=

# ─── DASHBOARD ───
DASHBOARD_PORT=5055
DASHBOARD_HOST=0.0.0.0
# Secret para session cookies (GENERA UNO FUERTE: openssl rand -hex 32)
SECRET_KEY=

# ─── USUARIO ADMIN INICIAL ───
# Solo se aplica en primer arranque cuando users.json está vacío.
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# ─── API KEYS (opcional — se pueden configurar via dashboard) ───
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
TM_DISCOVERY_KEY=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── IMAP 3DS ───
IMAP_HOST=imap.gmail.com
IMAP_USERNAME=
IMAP_PASSWORD=

# ─── OBSERVABILIDAD ───
SENTRY_DSN=
LOG_LEVEL=INFO
